# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env. It is listed in .gitignore.

# --- Postgres superuser: used ONCE by `npm run db:setup` to create the database and roles ---
PG_HOST=localhost
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=            # REQUIRED for db:setup

# --- Filled in automatically by `npm run db:setup` (random passwords) ---
# DATABASE_OWNER_URL: owns the schema, used only for migrations.
# DATABASE_URL: restricted app user (cannot alter schema or edit ledgers/audit log).
DATABASE_OWNER_URL=
DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
# 32+ random bytes, base64. db:setup generates it if empty.
SESSION_SECRET=
# Where uploaded staff documents and the company logo are stored (outside the web root).
STORAGE_DIR=./storage
# Where `pg_dump` backups are written. Path to pg_dump/psql binaries if they are not on PATH.
BACKUP_DIR=./backups
PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin
# Encrypts backup files (AES-256). Keep a copy OFF this server - without it backups cannot be restored.
BACKUP_PASSPHRASE=
